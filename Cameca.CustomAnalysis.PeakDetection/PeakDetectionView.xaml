<UserControl x:Class="Cameca.CustomAnalysis.PeakDetection.PeakDetectionView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cameca.CustomAnalysis.PeakDetection"
             xmlns:utilities="clr-namespace:Cameca.CustomAnalysis.Utilities.Controls;assembly=Cameca.CustomAnalysis.Utilities"
             xmlns:controls="clr-namespace:Cameca.Extensions.Controls;assembly=Cameca.Extensions.Controls"
             xmlns:utilities1="clr-namespace:Cameca.CustomAnalysis.Utilities;assembly=Cameca.CustomAnalysis.Utilities"
             xmlns:elementselection="clr-namespace:Cameca.CustomAnalysis.PeakDetection.ElementSelection"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{Binding Node}"
             d:DataContext="{d:DesignInstance Type={x:Type local:PeakDetection}}">
    <UserControl.Resources>
        <local:NullVisibilityConverter x:Key="NullVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <utilities:ButtonOverlayControl ButtonContent="Update"
                                   ButtonCommand="{Binding UpdateCommand}"
                                   OverlayVisibility="{Binding UpdateCommandCanExecute, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <elementselection:ElementSelectionModelConverter x:Key="ElementSelectionModelConverter" />
                    <elementselection:ElementSelectionModelConverter FilterToIncludeComplex="True" x:Key="ComplexElementSelectionModelConverter" />
                    <Style TargetType="Label" x:Key="KeyLabel">
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="Margin" Value="0 0 2 0" />
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </Grid.Resources>

                <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyLabel}" Content="Elements:" />
                <Label Grid.Row="0" Grid.Column="1">
                    <TextBlock Text="{Binding Properties.ElementSelectionModels, Converter={StaticResource ElementSelectionModelConverter}}" />
                </Label>

                <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyLabel}" Content="Molecules For:" />
                <Label Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="{Binding Properties.ElementSelectionModels, Converter={StaticResource ComplexElementSelectionModelConverter}}" />
                </Label>

                <Button Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Content="Edit Elements"
                        Margin="0"
                        Command="{Binding SelectElementsCommand}" />

                <controls:PropertyGrid Grid.Row="4"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Margin="0"
                                       ShowCategories="False"
                                       SelectedObject="{Binding Properties}"/>
            </Grid>


            <utilities:ButtonOverlayControl Grid.Column="1"
                                            ButtonContent="Run Peak Detection"
                                            ButtonCommand="{Binding RunPeakDetectionCommand}"
                                            OverlayVisibility="{Binding RunPeakDetectionCommandCanExecute, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="500" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:Chart2D Grid.Row="0"
                                      Grid.Column="0"
                                      IsLogScaleY="True"
                                      AxisXLabel="Da"
                                      AxisYLabel="Count"
                                      DataSource="{Binding ChartDataSource}"
                                      UseDefaultViewportResetBehavior="{Binding NoValidViewport}"
                                      ViewportLower="{Binding Properties.ViewportLower}"
                                      ViewportUpper="{Binding Properties.ViewportUpper}"
                                      UseApplicationViewManager="True" />

                    <GridSplitter Grid.Row="0"
                                  Grid.Column="1"
                                  VerticalAlignment="Stretch"
                                  HorizontalAlignment="Center"/>

                    <DataGrid Grid.Row="0"
                              Grid.Column="2"
                              AutoGenerateColumns="False"
                              Background="White"
                              ItemsSource="{Binding Ranges}"
                              HorizontalGridLinesBrush="LightGray"
                              VerticalGridLinesBrush="LightGray"
                              IsReadOnly="True">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#deecf9"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#eff6fc"/>
                            <Style x:Key="NumericTextBlock" TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Background="{TemplateBinding Background}"
                                                SnapsToDevicePixels="True">
                                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Border Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    BorderThickness="1"
                                                    BorderBrush="Black">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding IonTypeInfoRange.Color}"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding IonTypeInfoRange.Name, Mode=OneWay}" />
                            <DataGridTextColumn Header="Min" Binding="{Binding IonTypeInfoRange.Min, StringFormat=N3, Mode=OneWay}" ElementStyle="{StaticResource NumericTextBlock}" />
                            <DataGridTextColumn Header="Max" Binding="{Binding IonTypeInfoRange.Max, StringFormat=N3, Mode=OneWay}" ElementStyle="{StaticResource NumericTextBlock}" />
                            <DataGridTextColumn Header="Type Confidence" Binding="{Binding Confidence, StringFormat=N3, Mode=OneWay}" ElementStyle="{StaticResource NumericTextBlock}" />

                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Border Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    BorderThickness="1"
                                                    BorderBrush="Black"
                                                    Visibility="{Binding IonTypeInfoRange2, Converter={StaticResource NullVisibilityConverter}}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding IonTypeInfoRange2.Color}"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="2nd Name" Binding="{Binding IonTypeInfoRange2.Name, Mode=OneWay, TargetNullValue=''}" />
                            <DataGridTextColumn Header="2nd Confidence" Binding="{Binding Confidence2, StringFormat=N3, Mode=OneWay, TargetNullValue=''}" ElementStyle="{StaticResource NumericTextBlock}" />
                            <DataGridTemplateColumn Header="Use 2rn">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  Visibility="{Binding IonTypeInfoRange2, Converter={StaticResource NullVisibilityConverter}}"
                                                  IsChecked="{Binding Use2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Content="Apply Peaks"
                            Command="{Binding ApplyPeaksCommand}" />
                </Grid>
            </utilities:ButtonOverlayControl>
        </Grid>
    </utilities:ButtonOverlayControl>
</UserControl>

